# Copy this file to .env and fill in the values below.

# --- Required ---
DISCORD_TOKEN=your_discord_bot_token
OPENAI_API_KEY=your_openai_api_key
NGROK_AUTHTOKEN=your_ngrok_auth_token

# --- Database ---
# Leave blank for a fresh local MySQL install with no root password.
# For Docker, this also becomes the containerized MySQL's root password
# on first boot — set it to something real if you're not just doing local dev.
DB_PASSWORD=

# Everything below has a working default in config.py. Uncomment only if
# you need to override it (non-default MySQL port/db name, etc). Docker
# overrides DB_HOST/DB_PORT/DB_USER on its own regardless of what's set here.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_NAME=stacy_hr_db
# REPORT_PORT=5000
